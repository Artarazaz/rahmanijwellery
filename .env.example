# Market provider
# TGJU webservice credentials belong on the server and must never be exposed in JavaScript.
# Free public-page mode (no API key):
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=.vercel.app,127.0.0.1,localhost
MARKET_PROVIDER=tgju_scrape
# For the official provider instead, use MARKET_PROVIDER=tgju and set its URL/token.
MARKET_PROVIDER_URL=https://YOUR-TGJU-ENDPOINT
MARKET_PROVIDER_TOKEN=YOUR_TGJU_TOKEN
MARKET_PROVIDER_ITEMS=usd,eur,geram18,geram24,silver_999

# TGJU commonly reports Iranian prices in rial; the site displays toman.
MARKET_PROVIDER_UNIT=rial
MARKET_DISPLAY_UNIT=toman
MARKET_PRICE_CACHE_SECONDS=10
MARKET_PROVIDER_TIMEOUT_SECONDS=8
MARKET_UPDATE_INTERVAL_SECONDS=10
MARKET_SNAPSHOT_STALE_AFTER_SECONDS=30

# Fast official TGJU market-list source used by the scraper.
TGJU_MARKET_LIST_API_URL=https://api.tgju.org/v1/market/list-data
TGJU_GOLD_CATEGORY_ID=91818
TGJU_CURRENCY_CATEGORY_ID=28070
TGJU_PROFILE_BASE_URL=https://www.tgju.org/profile

# Optional public-page fallback. Use only where TGJU permits this access pattern.
# MARKET_PROVIDER=tgju_scrape
# TGJU_SCRAPE_URL=https://www.tgju.org/home
# TGJU_SCRAPE_GOLD_URL=https://www.tgju.org/gold-chart

# Local/dev hosts
ALLOWED_HOSTS=127.0.0.1,localhost
